### Quick Start Pattern

```python
# Step 1 — load .env into os.environ BEFORE any other imports
from dotenv import load_dotenv
load_dotenv()  # no-op in deployed AKS environments

from coles_agentic_sdk.workflow import bootstrap
from coles_agentic_sdk.agents import connect_foundry_agent

# Step 2 — bootstrap wires config, credential, and observability
boot = bootstrap()

# Step 3 — connect to the agent
async with boot.credential() as cred:
    agent = connect_foundry_agent(
        boot.config,
        credential=cred,
        agent_name="my-agent",
        orchestration_id="req-abc123",  # workflow-level correlation ID
    )
    session = agent.create_session()
    response = await agent.run("What products are on promotion?", session=session)
    print(response.text)
```

