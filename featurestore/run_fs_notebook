      pk_check = {"primary_keys" : spark.sql(SQLCOMMAND_PK).collect()[0][0]}
      for r in res:
        r.update(pk_check)
    send_to_status_table(res, target_schema = all_params["target_schema"])
    
  return(res)

def send_to_status_table(res, target_schema):
  schema = StructType([
            StructField('model_code', StringType(), True),
            StructField('query_name', StringType(), True),
            StructField('count', LongType(), True),
            StructField('primary_keys', LongType(), True),
            StructField('run_time_sec', DoubleType(), True),
            StructField('start_time', StringType(), True),
            StructField('end_time', StringType(), True),
            StructField('job_id', StringType(), True),
            StructField('run_id', StringType(), True)
    ])
  res_status = validate_res(res)
  df = spark.createDataFrame(res_status, schema)
  status_table = target_schema + ".temp_status_table"
  #clear_status_tbl = 'delete from ' +status_table +" where model_code = '" + MODEL_CODE + "'"
  df.write.format("delta").mode("append").saveAsTable(status_table)
  
# Sequence job functions -----------------

def runQuery(data_config
             , cache_table_name
             , cache_table_name_yesterday
             , day_offset
             , loop_query
             , view_name):
  
  run_params = {
    "cache_table_name" : cache_table_name,
    "cache_table_name_yesterday" : cache_table_name_yesterday,
    "day_offset" : day_offset,
    "day_offset_next" : day_offset+1
  }
  run_params.update(data_config)
  loop_query = loop_query.format(**run_params) 
  spark.sql(loop_query).persist(StorageLevel.MEMORY_AND_DISK).createOrReplaceTempView(run_params["cache_table_name"])  
def insertResult(numDays, offsetDay, data_config, loop_query):
  table_name = data_config["table_name"]
  view_name = table_name.replace("ftr_", "", 1)
  target_schema = data_config["target_schema"] 
  runQuery(data_config = data_config,
           cache_table_name = view_name+"0",
           cache_table_name_yesterday = f"{target_schema}.{table_name}",
           day_offset = offsetDay - 1,
           loop_query = loop_query,
           view_name = view_name
  ) 
  for offset in range(numDays):
    runQuery(data_config = data_config,
             cache_table_name = view_name+f"{offset+1}",
             cache_table_name_yesterday = view_name+f"{offset}",
             day_offset = offsetDay + offset,
             loop_query = loop_query,
             view_name = view_name
    ) 
  union_query = " UNION ALL ".join([f"SELECT * FROM {view_name}{q}" for q in range(numDays)])
  
  insert_query = f"""INSERT INTO {target_schema}.{table_name}
  {union_query}
  """
  print(insert_query) 
  spark.sql(insert_query) 
  # q= "insert into  aa_smkt_pfs_v3.time_day_dm_dummy select day_dt,day_idnt from biw.time_day_dm limit 5 "
  # print(q)
  # spark.sql(q)
  return(True)

def runForDays(totalNumDays, daysPerInsert, data_config, loop_query):
  numIter = int(totalNumDays / daysPerInsert)
  remainder = totalNumDays % daysPerInsert
  for i in range(numIter):
    insertResult(numDays = daysPerInsert, offsetDay = daysPerInsert * i, data_config = data_config, loop_query = loop_query)
  if remainder > 0:
    insertResult(numDays = remainder, offsetDay = numIter * daysPerInsert, data_config = data_config, loop_query = loop_query)
    
def exec_insert_step(sql_query, data_config, sequence_job):
  if sequence_job is True:
    date_format = "%Y%m%d" 
    run_config = copy.deepcopy(data_config) 
    run_config["n_days"] = (datetime.strptime(data_config["run_to_yyyymmdd"], date_format) - datetime.strptime(data_config["run_from_yyyymmdd"], date_format)).days + 1
    print("n_days: ", run_config["n_days"]) 
    runForDays(totalNumDays = run_config["n_days"], daysPerInsert = 10, data_config = run_config, loop_query = sql_query) 
  else:
    df = spark.sql(sql_query)


