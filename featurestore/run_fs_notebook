    pass

def validate_res(res):
  # coalesce nulls for uploading to SQL
  # doesn't matter for returning to R so we do it separately
  res_status = copy.deepcopy(res)
  for r in res_status:
    if "primary_keys" not in r.keys():
      r["primary_keys"] = None
    if "count" not in r.keys():
      r["count"] = None
  return(res_status)

